# Gemini AI — key thật chỉ đặt trong .env.local hoặc Vercel Environment Variables
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_AUTO_UPGRADE=true
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_VERSION=auto
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional pin; leave blank to discover an available image model from Google.
GEMINI_IMAGE_MODEL=
GEMINI_DELETE_UPLOADS=true
# Optional grounded style research; key/model discovery does not confirm quota.
GEMINI_SEARCH_ENABLED=false
GEMINI_DESIGN_RESEARCH_ENABLED=false
GEMINI_DESIGN_RESEARCH_QUOTA=unknown

# OpenAI chỉ là fallback tùy chọn. Có thể để trống khi dùng Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Tùy chọn. Để trống thì bản đồ dùng Leaflet/OpenStreetMap + fallback embed.
BMH_GOOGLE_MAPS_API_KEY=

# MoMo chỉ mở ở bước chốt dịch vụ; 10 bước thiết kế vẫn mở, không bắt đăng nhập.
# Áp dụng sql/BMH_GUEST_SERVICE_ORDERS.sql trước khi đặt GUEST_ORDERS_READY=true.
# Giữ tắt cho đến khi có giá dịch vụ thực tế và kiểm tra giao dịch sandbox.
BMH_CHECKOUT_ENABLED=false
BMH_GUEST_ORDERS_READY=false
BMH_SERVICE_PRICE_VND=
BMH_SERVICE_TITLE=Dịch vụ thiết kế BMH
BMH_PUBLIC_URL=
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: server key with Places API enabled, for nearby sellers and phone/address.
# Separate from the browser Maps key; never embed this key in the frontend.
BMH_GOOGLE_PLACES_API_KEY=
# Explicit opt-in after the operator reviews Places access and billing.
BMH_GOOGLE_PLACES_ENABLED=false
# Optional site web research; leave disabled until quota/cost is confirmed.
GEMINI_SITE_SEARCH_ENABLED=false
GEMINI_SITE_SEARCH_QUOTA=unknown
# Set false to disable image generation; otherwise GEMINI_API_KEY enables the endpoint.
GEMINI_IMAGE_ENABLED=true
