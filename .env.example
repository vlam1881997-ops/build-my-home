# Public app URL used for payOS return/cancel links
BMH_PUBLIC_URL=https://your-domain.example

# Supabase (2026 recommended key model)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy fallback names are supported by this build:
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# payOS server-only credentials
PAYOS_CLIENT_ID=...
PAYOS_API_KEY=...
PAYOS_CHECKSUM_KEY=...

# Existing optional map key
BMH_GOOGLE_MAPS_API_KEY=...

# ============================================================
# AI COPILOT - DÁN OPENAI API KEY CỦA BẠN Ở ĐÂY
# Copy file này thành .env.local khi chạy local.
# Khi deploy Vercel, đặt 2 biến này trong Environment Variables.
# KHÔNG dán key vào src/*.js hoặc bất kỳ mã frontend nào.
# ============================================================
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-astra
