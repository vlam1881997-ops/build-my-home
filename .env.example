# Build My Home V5.0.3 - AI Home Studio
# Copy this file to .env.local for local development. Never commit .env.local.

# Gemini - main multimodal AI
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_AUTO_UPGRADE=true
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_VERSION=auto
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_DELETE_UPLOADS=true

# Optional map key. Leave blank to use the free map/fallback layer.
BMH_GOOGLE_MAPS_API_KEY=

# Optional cloud project saving. Leave blank while product testing if not needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Payment is intentionally deferred in V5.0.3 Studio Transformation.
# MoMo will be integrated after the product experience is finalized.
BMH_PUBLIC_URL=
