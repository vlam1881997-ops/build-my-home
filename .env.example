# Public app URL used for payOS return/cancel links
BMH_PUBLIC_URL=https://your-domain.example

# Supabase (2026 recommended key model)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy fallback names are supported:
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# payOS server-only credentials
PAYOS_CLIENT_ID=...
PAYOS_API_KEY=...
PAYOS_CHECKSUM_KEY=...

# Existing optional map key
BMH_GOOGLE_MAPS_API_KEY=...

# ============================================================
# GEMINI AI-NATIVE ENGINE - DÁN GOOGLE AI STUDIO API KEY Ở ĐÂY
# Copy file này thành .env.local khi chạy local.
# Khi deploy Vercel, đặt các biến này trong Environment Variables.
# KHÔNG dán key vào src/*.js hoặc mã frontend.
# ============================================================
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# AUTO UPGRADE:
# gemini-flash-latest là alias do Google tự trỏ sang bản Flash mới.
# Khi Google nâng model phía sau alias, app dùng bản mới mà không sửa code.
GEMINI_AUTO_UPGRADE=true
GEMINI_MODEL=gemini-flash-latest
# auto = thử API stable v1 trước, tự rơi về v1beta nếu feature chưa có.
GEMINI_API_VERSION=auto

# Nếu model "latest" mới tạm lỗi/không tương thích, backend tự rơi về bản GA ổn định này.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Xóa media khỏi Gemini Files API sau khi scan để giảm lưu dữ liệu không cần thiết.
GEMINI_DELETE_UPLOADS=true

# OpenAI chỉ là fallback tùy chọn. Có thể để trống nếu chỉ dùng Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
