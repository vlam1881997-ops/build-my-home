# Gemini AI — key thật chỉ đặt trong .env.local hoặc Vercel Environment Variables
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_AUTO_UPGRADE=true
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_VERSION=auto
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_DELETE_UPLOADS=true

# OpenAI chỉ là fallback tùy chọn. Có thể để trống khi dùng Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Tùy chọn. Để trống thì bản đồ dùng Leaflet/OpenStreetMap + fallback embed.
BMH_GOOGLE_MAPS_API_KEY=

# Thanh toán / tài khoản cloud đang chủ động tạm bỏ khỏi bản FULL CLEAN.
# Khi sản phẩm hoàn thiện sẽ nối MoMo bằng module riêng, không ảnh hưởng engine hiện tại.
